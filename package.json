{
  "name": "aipdf-editor",
  "productName": "AiPDF Editor",
  "version": "2.15.0",
  "description": "AiPDF Editor — a modern Electron-based PDF viewer & editor with AI assistance, contract intelligence, smart redaction, multi-provider read-aloud and an agentic AI bot",
  "main": "src/main/main.js",
  "author": "manjayofficial01-ui",
  "license": "MIT",
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "regenerator-runtime": "^0.14.1",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  },
  "scripts": {
    "test:ocr": "node scripts/ocr-test.mjs",
    "test:ocr-server": "node scripts/ocr-server-test.mjs",
    "test:ocr-packaged": "node scripts/ocr-diag.mjs",
    "test:hand": "node scripts/hand-tool-test.mjs",
    "test:menu": "node scripts/menu-test.mjs",
    "test:wiring": "node scripts/wiring-test.mjs",
    "test:walk": "node scripts/gui-walkthrough-test.mjs",
    "test:key": "node scripts/key-test.mjs",
    "test:text": "node scripts/text-tool-test.mjs",
    "test:reflow": "node --max-old-space-size=1024 scripts/reflow-test.mjs",
    "test:story": "node scripts/story-test.mjs",
    "test:truthful": "node scripts/truthful-save-test.mjs",
    "test:fonts": "node scripts/fontindex-test.mjs && node scripts/system-font-test.mjs",
    "test:tools": "node scripts/tools-test.mjs",
    "test:objects": "node scripts/object-edit-test.mjs",
    "test:overset": "node scripts/overset-badge-test.mjs",
    "test:direct": "node scripts/direct-edit-test.mjs",
    "test:markup": "node scripts/markup-test.mjs",
    "test:textbox": "node scripts/textbox-resize-test.mjs",
    "test:wheel": "node scripts/ctrl-wheel-zoom-test.mjs",
    "test:tables": "node scripts/table-detect-test.mjs && node scripts/table-fixture-test.mjs && node scripts/table-cell-blocks-test.mjs",
    "test:table-ui": "node scripts/table-cell-test.mjs",
    "test:stirling": "node scripts/stirling-test.mjs",
    "test:tablecell": "node scripts/table-cell-split-test.mjs",
    "test:aidocs": "node scripts/aidocs-test.mjs",
    "test:tts": "node scripts/tts-test.mjs",
    "test:overlay": "node scripts/overlay-test.mjs",
    "test:doctools": "node scripts/doctools-test.mjs",
    "test:resize": "node scripts/resize-test.mjs",
    "test:smoke": "node scripts/smoke-pdf.mjs",
    "test:launch": "node scripts/launch-test.mjs",
    "test:audit": "node scripts/audit-imports.mjs",
    "test:icon": "node scripts/icon-pack-test.mjs",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.aipdf.editor",
    "productName": "AiPDF Editor",
    "icon": "assets/icon.ico",
    "files": [
      "src/**",
      "assets/icon.ico",
      "assets/icon.png",
      "node_modules/**",
      "package.json",
      "!dist*/**"
    ],
    "extraResources": [
      {
        "from": "vendor/tessdata",
        "to": "tessdata"
      }
    ],
    "asarUnpack": [
      "**/tesseract.js-core/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "AiPDF-Editor-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "directories": {
      "output": "dist-build"
    }
  }
}
